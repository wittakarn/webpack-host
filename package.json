{
  "name": "webpack-host",
  "private": true,
  "scripts": {
    "build": "pnpm --parallel --filter \"./**\" build",
    "serve": "pnpm --parallel --filter \"./**\" serve ",
    "build:remotes": "pnpm --filter \"./remote_1\"  build",
    "serve:remotes": "pnpm --filter \"./remote_1\"  serve",
    "serve:hosts": "pnpm --filter \"./host\"  serve",
    "dev:hosts": "pnpm --filter \"./host\" dev",
    "stop": "kill-port --port 3000,5001"
  },
  "workspaces": [
    "host",
    "remote_1"
  ],
  "devDependencies": {
    "kill-port": "^2.0.1"
  }
}
